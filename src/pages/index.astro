---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/newsreader';
import DurabilitySequence from '../components/DurabilitySequence.astro';
import ProductConsole from '../components/ProductConsole.astro';
import SandboxSequence from '../components/SandboxSequence.astro';
import BrandLockup from '../components/BrandLockup.astro';
import ThemeControl from '../components/ThemeControl.astro';
import '../styles/global.css';

const siteTitle = 'Druks — The self-hosted home for durable agent apps';
const siteDescription =
  'Druks is the self-hosted home for durable agent apps. Use your Claude Code and Codex subscriptions for tickets, alerts, reviews, reports, and inboxes.';
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Druks',
  alternateName: 'druks.ai',
  url: 'https://druks.ai/',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content="Druks" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://druks.ai/" />
    <meta property="og:image" content="https://druks.ai/assets/social/druks-og-v2.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Druks — The self-hosted home for durable agent apps, with the Druks dragon"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content="https://druks.ai/assets/social/druks-og-v2.jpg" />
    <meta
      name="twitter:image:alt"
      content="Druks — The self-hosted home for durable agent apps, with the Druks dragon"
    />
    <link rel="canonical" href="https://druks.ai/" />
    <title>{siteTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0c" />
    <meta name="theme-color" content="#f7f7f7" />
    <script is:inline>
      const themeStorageKey = 'druks:website-theme';
      try {
        const savedTheme = localStorage.getItem(themeStorageKey);
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      } catch {
        document.documentElement.removeAttribute('data-theme');
      }
      const updateThemeColor = () => {
        const background = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
        document.querySelector('meta[name="theme-color"]:not([media])')?.setAttribute('content', background);
      };
      window.addEventListener('DOMContentLoaded', () => {
        updateThemeColor();
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        document.querySelectorAll('[data-theme-select]').forEach((select) => {
          let initialTheme = 'system';
          try {
            const storedTheme = localStorage.getItem(themeStorageKey);
            initialTheme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'system';
          } catch {
            // System is the safe fallback when browser storage is unavailable.
          }
          select.value = initialTheme;
          select.closest('.theme-control').dataset.currentTheme = initialTheme;
          select.addEventListener('change', () => {
            try {
              if (select.value === 'system') document.documentElement.removeAttribute('data-theme');
              else document.documentElement.dataset.theme = select.value;
              if (select.value === 'system') localStorage.removeItem(themeStorageKey);
              else localStorage.setItem(themeStorageKey, select.value);
            } catch {
              // Applying the requested theme does not depend on storage being available.
            }
            document.querySelectorAll('[data-theme-select]').forEach((copy) => {
              copy.value = select.value;
              copy.closest('.theme-control').dataset.currentTheme = select.value;
            });
            updateThemeColor();
          });
        });
        systemTheme.addEventListener('change', () => {
          try {
            if (!localStorage.getItem(themeStorageKey)) updateThemeColor();
          } catch {
            updateThemeColor();
          }
        });
      });
    </script>
    <link rel="preload" as="image" href="/assets/art/hero-druk-complete-v3.webp" />
    <link rel="preload" as="image" href="/assets/art/storm-panorama-v2.webp" />
    <script src="/scripts/pipeline.js?v=8" defer></script>
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="b019dd0d-0e8b-4cc2-8b7f-6d612aaa0ed0"
      data-domains="druks.ai,www.druks.ai"
    ></script>
  </head>
  <body>
    <canvas class="storm-canvas" data-storm-canvas aria-hidden="true"></canvas>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <svg class="glyph-sprite" aria-hidden="true" focusable="false">
      <symbol id="glyph-pearl" viewBox="0 0 24 24">
        <path d="M12 1.5a9.2 9.2 0 1 1 0 18.4 9.2 9.2 0 0 1 0-18.4Zm-3.6 4A5.7 5.7 0 0 0 6 8.7c-.2.8.8 1.3 1.4.7a7 7 0 0 1 3.4-2.1c.9-.2.8-1.5-.1-1.8a4.7 4.7 0 0 0-2.3 0Z"></path>
        <path d="M5.2 19.2c2.1 1.9 4.8 3.1 7.7 3.1 2.4 0 4.7-.7 6.6-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path>
      </symbol>
      <symbol id="glyph-theme-system" viewBox="0 0 20 20">
        <rect x="2.5" y="3" width="15" height="10.5" rx="1.4"></rect>
        <path d="M7 17h6M10 13.5V17"></path>
      </symbol>
      <symbol id="glyph-theme-light" viewBox="0 0 20 20">
        <circle cx="10" cy="10" r="3.2"></circle>
        <path d="M10 1.7v2M10 16.3v2M1.7 10h2M16.3 10h2M4.1 4.1l1.4 1.4m9 9 1.4 1.4m0-11.8-1.4 1.4m-9 9-1.4 1.4"></path>
      </symbol>
      <symbol id="glyph-theme-dark" viewBox="0 0 20 20">
        <path d="M16.8 12.4A7.2 7.2 0 0 1 7.6 3.2a7.4 7.4 0 1 0 9.2 9.2Z"></path>
      </symbol>
      <symbol id="glyph-chevron-down" viewBox="0 0 12 12">
        <path d="m3 4.5 3 3 3-3"></path>
      </symbol>
    </svg>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Druks home"><BrandLockup /></a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#platform">platform</a>
        <a href="#extend">apps</a>
        <a href="#ship">software factory</a>
        <a href="https://docs.druks.ai/" target="_blank" rel="noopener noreferrer">docs</a>
        <a href="https://druks.ai/blog">blog</a>
        <ThemeControl />
        <a
          class="github-link"
          href="https://github.com/czpython/druks"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Druks on GitHub"
        >
          <svg viewBox="0 0 16 16" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
        </a>
        <a class="nav-cta" href="#start">Get started</a>
      </nav>

      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="#platform">platform</a>
          <a href="#extend">apps</a>
          <a href="#ship">software factory</a>
          <a href="https://docs.druks.ai/" target="_blank" rel="noopener noreferrer">docs</a>
          <a href="https://druks.ai/blog">blog</a>
          <a href="https://github.com/czpython/druks" target="_blank" rel="noopener noreferrer">GitHub</a>
          <div class="mobile-theme-actions">
            <ThemeControl />
            <a class="nav-cta" href="#start">Get started</a>
          </div>
        </nav>
      </details>
    </header>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">
              Put agents on your
              <span class="rotating-wrap" data-rotator>
                <span class="rotating-word" data-work-word>tickets</span><span aria-hidden="true">.</span>
              </span>
              <span class="reduced-word">work.</span>
            </h1>
            <p class="reduced-work-list">tickets / alerts / reviews / reports / inbox</p>
            <p class="hero-sub">
              Get more from the Claude Code and Codex subscriptions you already pay for. Keep agents working after you close the terminal.
            </p>
            <div class="cta-row">
              <a class="button button-primary" href="#ship">See it in action</a>
              <a class="button button-secondary" href="#start">Install Druks</a>
            </div>
          </div>

        </div>
      </section>

      <section class="product-section section-band" id="platform" aria-labelledby="product-title">
        <div class="wrap product-layout">
          <div class="section-heading product-heading">
            <h2 class="section-title" id="product-title">
              <span>Platform.</span>
            </h2>
            <p>
              Druks is a platform for agent work that takes time, repeats, or waits for people and systems. It connects triggers, agent steps, approvals, and external actions in durable workflows that survive restarts and long waits. Apps define the job. Druks runs the job and records its history.
            </p>
          </div>

          <figure class="product-ui" aria-label="Interactive Druks app preview">
            <ProductConsole />
          </figure>
        </div>
      </section>

      <DurabilitySequence />

      <SandboxSequence />

      <section class="extend-section section-band" id="extend" aria-labelledby="extend-title">
        <div class="wrap">
          <div class="extend-layout">
            <div class="extend-copy">
              <h2 class="section-title" id="extend-title">
                <span>Extensible.</span>
              </h2>
              <p>
                A Druks app is a Python package. Install it and Druks discovers its workflows at boot; there is no separate registration step.
              </p>
              <p>
                An app can include its own data, settings, routes, and UI alongside its workflows and agents.
              </p>
              <a class="text-link" href="https://docs.druks.ai/writing-an-app" target="_blank" rel="noopener noreferrer">Build a Druks app <span aria-hidden="true">↗</span></a>
            </div>

            <div class="app-code-window" aria-label="Panel app entry point and Python class">
              <div class="code-window-bar"><span>druks-panel</span><span>installed package</span></div>
              <pre><code><span class="code-comment"># pyproject.toml</span>
<span class="code-name">[project.entry-points."druks.apps"]</span>
panel = <span class="code-string">"druks_panel.app:Panel"</span>

<span class="code-comment"># app.py</span>
<span class="code-keyword">from</span> druks.apps <span class="code-keyword">import</span> App

<span class="code-keyword">class</span> <span class="code-class">Panel</span>(App):
    name = <span class="code-string">"panel"</span>
    icon = <span class="code-string">"message-square"</span>
    description = <span class="code-string">"Pressure-tests a decision, then parks for the human call."</span></code></pre>
              <div class="code-window-foot"><span>package installed</span><span aria-hidden="true">→</span><span>app ready</span></div>
            </div>
          </div>

        </div>
      </section>

      <section class="ship-section section-band" id="ship" aria-labelledby="ship-title">
        <div class="wrap">
          <div class="section-heading ship-heading">
            <h2 class="section-title" id="ship-title">
              <span>Ticket in. PR out.</span>
            </h2>
            <p>
              The built-in Software Factory app implements and checks the change in an isolated sandbox, then opens a pull request. By default it waits for plan approval and final review; both gates are configurable. You decide what merges.
            </p>
          </div>

          <div class="ship-graph" id="ship-graph" data-ship-graph>
            <div class="graph-chrome">
              <span>software factory / durable run</span>
              <div class="graph-legend" aria-label="Graph legend">
                <span><i class="legend-runtime"></i>runtime</span>
                <span><i class="legend-agent"></i>agent work</span>
                <span><svg class="glyph glyph-pearl" aria-hidden="true"><use href="#glyph-pearl"></use></svg>human gate</span>
              </div>
            </div>

            <div class="graph-canvas">
              <span class="graph-lane graph-lane-control">control plane</span>
              <span class="graph-lane graph-lane-agent">agent execution</span>

              <svg class="graph-paths" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="ship-flow-gradient" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="var(--accent)"></stop>
                    <stop offset="40%" stop-color="var(--accent)"></stop>
                    <stop offset="52%" stop-color="var(--border-strong)"></stop>
                    <stop offset="82%" stop-color="var(--border-strong)"></stop>
                    <stop offset="100%" stop-color="var(--accent)"></stop>
                  </linearGradient>
                </defs>
                <path class="graph-path-base" pathLength="100" d="M 104 130 H 300 L 456 290 H 936 L 1094 130"></path>
                <path class="graph-path-progress" id="trackFill" pathLength="100" d="M 104 130 H 300 L 456 290 H 936 L 1094 130"></path>
                <circle class="graph-current" id="trackPulse" cx="104" cy="130" r="5"></circle>
              </svg>

              <div class="graph-gate graph-gate-plan" data-gate-index="2" aria-hidden="true">
                <svg class="glyph glyph-pearl"><use href="#glyph-pearl"></use></svg>
              </div>
              <div class="graph-gate graph-gate-review" data-gate-index="4" aria-hidden="true">
                <svg class="glyph glyph-pearl"><use href="#glyph-pearl"></use></svg>
                <span>review gate</span>
              </div>

              <ol class="ship-steps" id="ship-stations" aria-label="Software Factory run sequence">
                <li class="station node-ticket node-runtime" data-i="0">
                  <button class="station-trigger" type="button" aria-label="Ticket: work item received">
                    <span class="node-index">01</span>
                    <span class="node-owner">tracker</span>
                    <strong class="station-name">ticket</strong>
                    <span class="station-note">work item received</span>
                    <span class="node-output">recorded</span>
                  </button>
                </li>
                <li class="station node-scope node-runtime" data-i="1">
                  <button class="station-trigger" type="button" aria-label="Scope: requirements and constraints">
                    <span class="node-index">02</span>
                    <span class="node-owner">druks</span>
                    <strong class="station-name">scope</strong>
                    <span class="station-note">requirements and constraints</span>
                    <span class="node-output">checkpoint saved</span>
                  </button>
                </li>
                <li class="station node-plan node-agent" data-i="2">
                  <button class="station-trigger" type="button" aria-label="Plan: implementation plan, human approval">
                    <span class="node-index">03</span>
                    <span class="node-owner">planning agent</span>
                    <strong class="station-name">plan</strong>
                    <span class="station-note">implementation plan</span>
                    <span class="node-output node-output-gate"><svg class="glyph glyph-pearl" aria-hidden="true"><use href="#glyph-pearl"></use></svg>human approval</span>
                  </button>
                </li>
                <li class="station node-implement node-agent" data-i="3">
                  <button class="station-trigger" type="button" aria-label="Implement: repository changes in an isolated sandbox">
                    <span class="node-index">04</span>
                    <span class="node-owner">coding agent</span>
                    <strong class="station-name">implement</strong>
                    <span class="station-note">repository changes</span>
                    <span class="node-output">isolated sandbox</span>
                  </button>
                </li>
                <li class="station node-review node-agent" data-i="4">
                  <button class="station-trigger" type="button" aria-label="Review: independent check, review gate">
                    <span class="node-index">05</span>
                    <span class="node-owner">review agent</span>
                    <strong class="station-name">review</strong>
                    <span class="station-note">independent check</span>
                    <span class="node-output node-output-gate"><svg class="glyph glyph-pearl" aria-hidden="true"><use href="#glyph-pearl"></use></svg>review gate</span>
                  </button>
                </li>
                <li class="station node-pr node-runtime" data-i="5">
                  <button class="station-trigger" type="button" aria-label="Pull request: reviewable change, human merge">
                    <span class="node-index">06</span>
                    <span class="node-owner">GitHub</span>
                    <strong class="station-name">pull request</strong>
                    <span class="station-note">reviewable change</span>
                    <span class="node-output node-output-gate"><svg class="glyph glyph-pearl" aria-hidden="true"><use href="#glyph-pearl"></use></svg>human merge</span>
                  </button>
                </li>
              </ol>
            </div>

            <div class="graph-readout" aria-live="polite">
              <span class="readout-sequence" id="rseq">01 / 06</span>
              <span class="readout-stage" id="rstage">ticket</span>
              <strong class="readout-message" id="rmsg">Work item received</strong>
              <span class="readout-meta" id="rmeta">run / started</span>
            </div>
          </div>
        </div>
      </section>

      <section class="start-section lifted-band" id="start" aria-labelledby="start-title">

        <div class="wrap start-inner">
          <h2 class="section-title section-title-centered" id="start-title">
            <span>Start here.</span>
          </h2>
          <p>Install Druks. Connect your Claude Code or Codex subscription. Then choose an app.</p>

          <div class="install-line" aria-label="One-line install command">
            <span class="terminal-prompt" aria-hidden="true">$</span>
            <code id="install-cmd">curl -fsSL https://druks.ai/install.sh | bash</code>
            <button class="copy-button" id="copy-install" type="button" aria-live="polite" aria-label="Copy install command">copy</button>
          </div>

          <div class="cta-row start-actions">
            <a class="button button-primary" href="https://docs.druks.ai/" target="_blank" rel="noopener noreferrer">Read the docs <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="https://github.com/czpython/druks" target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <a class="footer-brand" href="#top" aria-label="Druks, back to the top"><BrandLockup /></a>
        <p>{siteTitle}</p>
        <div class="footer-links">
          <a href="https://github.com/czpython/druks/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT license</a>
          <a href="https://docs.druks.ai/" target="_blank" rel="noopener noreferrer">docs</a>
          <a href="https://druks.ai/blog">blog</a>
          <a href="https://github.com/czpython/druks" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
