  }

  .sandbox-tabs button[aria-selected='true']::after {
    position: absolute;
    right: 10px;
    bottom: -15px;
    left: 10px;
    height: 2px;
    background: var(--cyan);
    content: '';
  }

  .sandbox-panel {
    padding: 26px 22px;
    transition: opacity 180ms ease;
  }

  .sandbox-console[data-phase='idle'] .sandbox-panel {
    opacity: 0;
    visibility: hidden;
  }

  .sandbox-context {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--border);
  }

  .sandbox-context > div {
    padding: 0 14px 17px 0;
    opacity: 0.2;
    transition: opacity 180ms ease;
  }

  .sandbox-context > div.is-visible {
    opacity: 1;
  }

  .sandbox-context dt,
  .sandbox-context dd {
    margin: 0;
  }

  .sandbox-context dt {
    color: var(--text-muted);
    font-size: 7px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .sandbox-context dd {
    margin-top: 6px;
    overflow: hidden;
    color: var(--text-mid);
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sandbox-events,
  .sandbox-table {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sandbox-events {
    margin-top: 18px;
  }

  .sandbox-events li,
  .sandbox-table li,
  .sandbox-table-heading {
    display: grid;
    min-width: 0;
    align-items: center;
  }

  .sandbox-events li {
    min-height: 42px;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 14px;
    border-bottom: 1px solid var(--border-soft);
    opacity: 0.18;
    transition:
      background 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  .sandbox-events li.is-visible {
    opacity: 1;
  }

  .sandbox-events li.is-current {
    background: linear-gradient(90deg, rgb(77 212 244 / 8%), transparent 76%);
  }

  .sandbox-events time,
  .sandbox-events b {
    color: var(--text-muted);
    font-size: 7.5px;
    font-weight: 450;
  }

  .sandbox-events span {
    overflow: hidden;
    color: var(--text-mid);
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sandbox-events li.is-current span,
  .sandbox-events li.is-current b {
    color: var(--cyan);
  }

  .sandbox-table-heading,
  .sandbox-table li {
    grid-template-columns: minmax(0, 1fr) 70px 86px;
    gap: 16px;
  }

  .sandbox-table-heading {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 7px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .sandbox-table li {
    min-height: 50px;
    border-bottom: 1px solid var(--border-soft);
    opacity: 0.18;
    transition: opacity 180ms ease;
  }

  .sandbox-table li.is-visible {
    opacity: 1;
  }

  .sandbox-table li span {
    overflow: hidden;
    color: var(--text-mid);
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sandbox-table li b {
    color: var(--text-muted);
    font-size: 8px;
    font-weight: 450;
  }

  .sandbox-table li strong {
    color: #94d82d;
    font-size: 8px;
    font-weight: 560;
    text-transform: uppercase;
  }

  .sandbox-table li.is-blocked strong {
