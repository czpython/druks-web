    color: #94d82d;
  }

  .sandbox-table-summary span {
    color: #ff6b7b;
  }

  @keyframes sandbox-status-pulse {
    0%,
    100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.42; transform: scale(1.6); }
  }

  @media (max-width: 900px) {
    .sandbox-console-body {
      grid-template-columns: 1fr;
    }

    .sandbox-list {
