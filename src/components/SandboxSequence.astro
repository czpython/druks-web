      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 680px) {
    .sandbox-intro > p {
      font-size: 16px;
    }

    .sandbox-console-brand span {
      display: none;
    }

    .sandbox-console-body {
      min-height: 620px;
    }

    .sandbox-detail-heading {
      align-items: flex-start;
      flex-direction: column;
    }

