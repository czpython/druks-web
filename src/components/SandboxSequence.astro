    }

    .sandbox-context {
      grid-template-columns: 1fr;
    }

    .sandbox-events li {
      grid-template-columns: 44px minmax(0, 1fr);
    }

    .sandbox-events b {
      display: none;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .sandbox-status-dot {
      animation: none !important;
    }

    .sandbox-instance,
    .sandbox-context > div,
    .sandbox-events li,
    .sandbox-table li {
      transition: none;
    }
  }
</style>
