    display: block;
  }

  .sandbox-detail-heading > div:first-child strong {
    color: var(--text);
    font-size: 11px;
  }

  .sandbox-detail-heading > div:first-child span {
    margin-top: 5px;
    color: var(--cyan);
    font-size: 8px;
  }

  .sandbox-tabs {
    display: flex;
    align-self: stretch;
  }

