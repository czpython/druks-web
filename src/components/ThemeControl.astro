<div class="theme-control">
  <span class="theme-control-display" aria-hidden="true">
    <svg data-theme-icon="system" viewBox="0 0 20 20" focusable="false"><use href="#glyph-theme-system"></use></svg>
    <svg data-theme-icon="light" viewBox="0 0 20 20" focusable="false"><use href="#glyph-theme-light"></use></svg>
    <svg data-theme-icon="dark" viewBox="0 0 20 20" focusable="false"><use href="#glyph-theme-dark"></use></svg>
    <svg class="theme-control-chevron" viewBox="0 0 12 12" focusable="false"><use href="#glyph-chevron-down"></use></svg>
  </span>
  <select data-theme-select aria-label="Color theme">
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</div>
